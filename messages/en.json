  "help": {
    "title": "Help Center",
    "subtitle": "Find answers to frequently asked questions",
    "faq": "FAQ",
    "faqTitle": "Frequently Asked Questions (FAQ)",
    "faqDesc": "Common questions and answers",
    "foundAnswers": "Found {count} answers",
    "contact": "Contact Us",
    "contactDesc": "Send your questions or suggestions via email",
    "about": "About Us",
    "searchQuestions": "Search questions...",
    "noResultsFor": "No answers found for \"{query}\"",
    "clearSearch": "Clear search",
    "faqs": {
      "gettingStarted": {
        "category": "Getting Started",
        "createAccount": {
          "q": "How to create an account?",
          "a": "You can create an account by clicking the 'Register' button on the homepage. Then fill in your student ID, name, email, and password. The system will send a confirmation email to your specified email address."
        },
        "forgotPassword": {
          "q": "I forgot my password, what should I do?",
          "a": "Click on the 'Forgot Password' link on the Login page and enter your email. The system will send a password reset link to your email."
        },
        "otherUniversity": {
          "q": "Can I use an account from another university?",
          "a": "Currently, the system only supports students from Sukhothai Thammathirat Open University (STOU)."
        }
      },
      "search": {
        "category": "Search",
        "howToSearch": {
          "q": "How to search for tourist attractions?",
          "a": "Type the province name, place, or what you're interested in the search box. You can filter results using Filter Tabs (All, Website, Image, Video, AI Mode)."
        },
        "aiMode": {
          "q": "What is AI Mode?",
          "a": "AI Mode is a feature that uses AI to summarize information and answer questions about tourist attractions. You can ask questions directly and AI will provide answers with references."
        },
        "imageSearch": {
          "q": "Can I search by image?",
          "a": "Yes, click the image icon in the search box and upload the image you want to search. The system will find similar places."
        },
        "voiceSearch": {
          "q": "Can I search by voice?",
          "a": "Yes, click the microphone icon in the search box and speak what you want to search."
        }
      },
      "folders": {
        "category": "My Folders",
        "whatIsFolder": {
          "q": "What is a Folder?",
          "a": "A Folder is a place to store tourist attractions you're interested in. You can create multiple folders like 'Bangkok', 'Chiang Mai' to organize places you want to visit."
        },
        "createFolder": {
          "q": "How to create a Folder?",
          "a": "Go to My Folders page and click 'Create New Folder'. Set the name and description, then choose whether it's public or private."
        },
        "saveToFolder": {
          "q": "How to save places to a Folder?",
          "a": "Click the 'Save to Folder' button on each place, then select the Folder you want to save to, or create a new Folder."
        },
        "shareFolder": {
          "q": "Can I share a Folder?",
          "a": "Yes, if you set the Folder as 'Public', you can share the link with friends to view."
        }
      },
      "favorites": {
        "category": "Favorites",
        "whatIsFavorites": {
          "q": "What are Favorites?",
          "a": "Favorites is a place to store places you've liked. You can easily access it from your profile page."
        },
        "differenceFolders": {
          "q": "How is it different from Folders?",
          "a": "Favorites is for quick saving without categorization. Folders are for detailed organization."
        }
      },
      "privacy": {
        "category": "Privacy",
        "dataSecurity": {
          "q": "Is my data secure?",
          "a": "We have standard data security measures. Your personal information will not be shared with third parties."
        },
        "deleteAccount": {
          "q": "Can I delete my account?",
          "a": "Yes, go to Profile > Settings > Delete Account. All your data will be permanently deleted."
        }
      }
    }
  },
